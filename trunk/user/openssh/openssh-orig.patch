diff -Nur orig/auth.c b/auth.c
--- orig/auth.c	2026-11-05 07:57:26.000000000 +0800
+++ b/auth.c	2026-11-19 13:30:09.352981920 +0800
@@ -260,6 +260,66 @@
 	return ret;
 }
 
+/*
+ * Padavan: SSH 登录成功/失败时，按 NVRAM 配置调用 wxsend.sh 发送微信通知。
+ * 放在 auth_log 内调用，是因为该函数在认证结果确定后执行一次；
+ * 这里不提前 return，避免跳过后面的失败登录审计。
+ */
+static void
+wxsend_auth_notice(struct ssh *ssh, int authenticated)
+{
+	char buffer[128];
+	char title[128] = "SSH登录";
+	char command[512];
+	FILE *fp;
+	int enable, mode;
+
+	fp = popen("nvram get wxsend_enable", "r");
+	if (fp == NULL)
+		return;
+	if (fgets(buffer, sizeof(buffer), fp) == NULL)
+		buffer[0] = '\0';
+	enable = atoi(buffer);
+	fclose(fp);
+	if (enable != 1 && enable != 2)
+		return;
+
+	fp = popen("nvram get wxsend_title", "r");
+	if (fp != NULL) {
+		if (fgets(buffer, sizeof(buffer), fp) != NULL &&
+		    buffer[0] != '\0') {
+			buffer[strcspn(buffer, "\n")] = '\0';
+			strncpy(title, buffer, sizeof(title) - 1);
+			title[sizeof(title) - 1] = '\0';
+		}
+		fclose(fp);
+	}
+
+	fp = popen("nvram get wxsend_ssh", "r");
+	if (fp == NULL)
+		return;
+	if (fgets(buffer, sizeof(buffer), fp) == NULL)
+		buffer[0] = '\0';
+	mode = atoi(buffer);
+	fclose(fp);
+
+	if (authenticated) {
+		if (mode == 1 || mode == 3) {
+			snprintf(command, sizeof(command),
+			    "/usr/bin/wxsend.sh send_message \"【%s】\" "
+			    "\"用户IP：\" \"%s\" \"SSH登录验证成功！\"",
+			    title, ssh_remote_ipaddr(ssh));
+			system(command);
+		}
+	} else if (mode == 2 || mode == 3) {
+		snprintf(command, sizeof(command),
+		    "/usr/bin/wxsend.sh send_message \"【%s】\" "
+		    "\"用户IP：\" \"%s\" \"SSH登录验证失败！\"",
+		    title, ssh_remote_ipaddr(ssh));
+		system(command);
+	}
+}
+
 void
 auth_log(struct ssh *ssh, int authenticated, int partial,
     const char *method, const char *submethod)
@@ -302,6 +362,8 @@
 	    extra != NULL ? ": " : "",
 	    extra != NULL ? extra : "");
 
+	wxsend_auth_notice(ssh, authenticated);
+
 	free(extra);
 
 #if defined(CUSTOM_FAILED_LOGIN) || defined(SSH_AUDIT_EVENTS)
